# Required: PostgreSQL connection used by Prisma.
# Replace YOUR_PASSWORD with your local PostgreSQL password.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/claims_intelligence?schema=public"

# Required: OpenAI API key. Do not commit a real key.
OPENAI_API_KEY="your-openai-api-key"

# Optional: defaults to gpt-4o-mini.
OPENAI_MODEL="gpt-4o-mini"

# Optional: defaults to 3000.
PORT=3000

# Optional: allowed browser origin for the frontend; defaults to localhost:5173.
FRONTEND_URL="http://localhost:5173"
